<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Website</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body {
    font-family: 'Segoe UI', sans-serif;
}

/* HERO */
.hero {
    background: linear-gradient(135deg, #1e90ff, #00c6ff);
    color: #fff;
    padding: 100px 0;
    text-align: center;
}
.hero h1 {
    font-size: 48px;
    font-weight: bold;
}

/* FEATURES */
.feature-box {
    padding: 30px;
    border-radius: 10px;
    background: #f8f9fa;
    transition: 0.3s;
}
.feature-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

/* FOOTER */
.footer {
    background: #111;
    color: #aaa;
    padding: 20px 0;
    text-align: center;
}
</style>

</head>
<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
<div class="container">
    <a class="navbar-brand" href="#">MyWebsite</a>

    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto">
            <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Features</a></li>
            <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
            <li class="nav-item">
                <a class="btn btn-success ms-3" href="/admin/login">Admin Login</a>
            </li>
        </ul>
    </div>
</div>
</nav>

<!-- ================= HERO ================= -->
<section class="hero">
    <div class="container">
        <h1>Welcome to My Website 🚀</h1>
        <p class="mt-3">Fast, Secure & Easy Payment System</p>
        <a href="#" class="btn btn-light mt-4 px-4">Get Started</a>
    </div>
</section>

<!-- ================= FEATURES ================= -->
<section class="py-5">
<div class="container">
    <div class="text-center mb-5">
        <h2>Our Features</h2>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="feature-box text-center">
                <h4>⚡ Fast Payments</h4>
                <p>Instant deposit & withdrawal system.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-box text-center">
                <h4>🔒 Secure</h4>
                <p>Top-level security for transactions.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-box text-center">
                <h4>📱 Easy Access</h4>
                <p>Mobile-friendly & easy to use.</p>
            </div>
        </div>
    </div>
</div>
</section>

<!-- ================= PAYMENT ================= -->
<section class="py-5 bg-light">
<div class="container text-center">
    <h2>Payment Methods</h2>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="feature-box">
                <h4>UPI Payment</h4>
                <p>Google Pay, PhonePe, Paytm supported</p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="feature-box">
                <h4>PrimeXPay</h4>
                <p>Fast & reliable payment gateway</p>
            </div>
        </div>
    </div>
</div>
</section>

<!-- ================= FOOTER ================= -->
<footer class="footer">
    <p>© 2026 MyWebsite. All Rights Reserved.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>