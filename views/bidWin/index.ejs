                <!-- PAGE BAR -->
                <div class="page-bar">
                    <div class="page-title-breadcrumb">
                        
                        <ol class="breadcrumb page-breadcrumb pull-right">
                            <li>
                                <i class="fa fa-home"></i>
                                <a class="parent-item" href="/admin">Home</a>
                                <i class="fa fa-angle-right"></i>
                            </li>
                            <li class="active">Win Bid Report</li>
                        </ol>
                    </div>
                </div>

                <!-- FILTER -->
                <div class="row">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Win Bid Report</h4>

                                <div class="row">
                                    <div class="form-group col-md-4">
                                        <label>Date</label>
                                        <input type="date" id="SubmitDate" class="form-control digits">
                                    </div>

                                    <div class="form-group col-md-5">
                                        <label>Game Name</label>
                                        <select id="game_id" class="form-control">
                                            <option selected disabled>-Select Game Name-</option>
                                        </select>
                                        
                                    </div>

                                    <div class="form-group col-md-3">
                                        <label>&nbsp;</label>
                                        <button type="button" id="submit" class="btn btn-primary btn-block mt-4">
                                            Submit
                                        </button>
