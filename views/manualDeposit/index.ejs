                <!-- PAGE BAR -->
<div class="page-bar">
    <div class="page-title-breadcrumb">
        <div class="pull-left">
            <div class="page-title">Manual Deposit History</div>
        </div>
        <ol class="breadcrumb page-breadcrumb pull-right">
            <li><i class="fa fa-home"></i><a href="/admin"> Home</a></li>
            <li class="active">Manual Deposit History</li>
        </ol>
    </div>
</div>

<!-- FILTER -->
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Manual Deposit History</h4>
                <div class="row">
                    <div class="form-group col-md-4">
                        <label>Date</label>
                        <input type="date" id="filter_date" class="form-control digits">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- TABLE -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body table-responsive">
                <table id="manualDepositTable" class="table table-bordered table-striped w-100">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User Name</th>
                            <th>Amount</th>
                            <th>Txn ID</th>
                            <th>Txn Date</th>
                        </tr>
                    </thead>
                    <tbody id="manualDepositBody">
                        <% if (data && data.length) { %>
                            <% data.forEach(function(v, i){ %>
                                <tr>
                                    <td><%= i+1 %></td>
                                    <td>
                                        <a href="/admin/single-user/<%= v.user_id %>">
                                            <%= v.name %><br>

                                        </a>
                                         <%= v.mobile %>
                                    </td>
                                    <td>₹<%= v.txn_crdt %></td>
                                    <td><%= v.transaction_id %></td>
                                    <td><%= v.txn_date %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
$(document).ready(function(){
    $('#manualDepositTable').DataTable();
});

/* FILTER ON CHANGE */
$('#filter_date').on('change', function(){
    const date = $(this).val();
    if(!date) return;

    $.post('/admin/manual-deposit-history/search', { date }, function(res){
        let html = '';

        if(res.status && res.data.length){
            res.data.forEach((v,i)=>{
                html += `
                <tr>
                    <td>${i+1}</td>
                    <td>${v.name}</td>
                    <td>₹${v.txn_crdt}</td>
                    <td>${v.transaction_id}</td>
                    <td>${v.txn_date}</td>
                </tr>`;
            });
        } else {
            html = `
              <tr>
                <td colspan="5" class="text-center text-danger">
                    No record found
                </td>
              </tr>`;
        }

        $('#manualDepositBody').html(html);
    });
});
</script>