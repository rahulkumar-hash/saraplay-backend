    <!-- PAGE BAR -->
    <div class="page-bar">
        <div class="page-title-breadcrumb">
            <ol class="breadcrumb page-breadcrumb pull-right">
                <li>
                    <i class="fa fa-home"></i>
                    <a class="parent-item" href="/admin">Home</a>
                    <i class="fa fa-angle-right"></i>
                </li>
                <li class="active">Customer Sell Report</li>
            </ol>
        </div>
    </div>

    <!-- FILTER -->
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Customer Sell Report</h4>

                    <div class="row">

                        <div class="form-group col-md-2">
                            <label>Date</label>
                            <input type="date" id="filter_date" class="form-control digits">
                        </div>

                        <div class="form-group col-md-3">
                            <label>Game Name</label>
                            <select id="filter_game" class="form-control">
                                <option value="">-Select Game Name-</option>
                            </select>
                        </div>

                        <div class="form-group col-md-3">
                            <label>Game Type</label>
                            <select id="filter_type" class="form-control">
                                <option value="">-Select Game Type-</option>
                                <option value="all">All Type</option>
                                <option value="Single Digit">Single Digit</option>
                                <option value="Jodi Digit">Jodi Digit</option>
                                <option value="Single Pana">Single Pana</option>
                                <option value="Double Pana">Double Pana</option>
                                <option value="Tripple Pana">Triple Pana</option>
                                <option value="Half Sangam">Half Sangam</option>
                                <option value="Full Sangam">Full Sangam</option>
                            </select>
                        </div>

                        <div class="form-group col-md-2">
                            <label>Session</label>
                            <select id="filter_session" class="form-control">
                                <option value="">-Select Session-</option>
                                <option value="1">Open</option>
                                <option value="2">Close</option>
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="sellTable" class="table table-striped table-bordered w-100">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>User Mobile</th>
                                    <th>Total Points</th>
                                </tr>
                            </thead>
                            <tbody id="sellBody">
                                <% if (users && users.length) { %>
                                    <% users.forEach(function(u, i){ %>
                                        <tr>
                                            <td><%= i+1 %></td>
                                            <td><%= u.mobile %></td>
                                            <td>0</td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
<script>
$(document).ready(function () {

    const now = new Date();
    const day = ("0"+now.getDate()).slice(-2);
    const month = ("0"+(now.getMonth()+1)).slice(-2);
    const today = now.getFullYear()+"-"+month+"-"+day;

    $('#filter_date').val(today);

    loadGames();
    loadReport();

    $('#filter_date, #filter_game, #filter_type, #filter_session').on('change', function () {
        loadReport();
    });

    $('#sellTable').DataTable({
        responsive: false,
        lengthMenu: [[10,25,50,100,-1],[10,25,50,100,"All"]],
        dom:
          "<'row'<'col-md-4'l><'col-md-4'B><'col-md-4'f>>" +
          "<'row'<'col-md-12'tr>>" +
          "<'row'<'col-md-5'i><'col-md-7'p>>",
        buttons: ["copy","csv","excel","pdf","print"]
    });
});

/* ======================
   LOAD GAMES
====================== */
function loadGames(){
    $.get('/admin/get-games-for-declare', function(res){
        let html = '<option value="">-Select Game Name-</option>';
        res.forEach(g=>{
            html += `<option value="${g.id}">${g.name}</option>`;
        });
        $('#filter_game').html(html);
    });
}

/* ======================
   LOAD REPORT
====================== */
function loadReport(){
    $.post('/admin/customer-sell-report/search',{
        date: $('#filter_date').val(),
        game_id: $('#filter_game').val(),
        game_type: $('#filter_type').val(),
        session: $('#filter_session').val()
    }, function(res){

        let html = '';

        if(res.status && res.data.length){
            res.data.forEach((v,i)=>{
                html += `
                  <tr>
                    <td>${i+1}</td>
                    <td>${v.mobile}</td>
                    <td>${v.total_points}</td>
                  </tr>`;
            });
        }else{
            html = `<tr>
                <td colspan="3" class="text-center text-danger">
                    No record found
                </td>
            </tr>`;
        }

        $('#sellBody').html(html);
    });
}
</script>