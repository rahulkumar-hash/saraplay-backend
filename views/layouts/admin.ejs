	<style>
		:root {
			--primary-color: <%= setting.primary_color || '#0d6efd' %>;
			--secondary-color: <%= setting.secondary_color || '#0d6efd' %>;
		}

		.btn.btn-primary {
			background-color: var(--primary-color) !important;
			border-color: var(--primary-color) !important;
		}

		.color_m{
			background-color: var(--primary-color) !important;
			border-color: var(--primary-color) !important;
		}
		.color_s{

			background-color: var(--secondary-color) !important;
			border-color: var(--secondary-color) !important;

		}

		.btn.btn-primary:hover {
			opacity: 0.9 !important;
		}
		.bg-danger {
			background-color: #e10101 !important;
			border: 1px solid #e10101;
		}
		.bg-success {
			background-color: #00713e !important;
			border: 1px solid #00713e;
		}
		.btn.btn-info {
			background-color: #013aaa !important;
			border: 1px solid #013aaa !important;
		}

		.sidebar .sidebar-logo .logo img {
			max-width: 66px !important;
		}
				
	</style>


