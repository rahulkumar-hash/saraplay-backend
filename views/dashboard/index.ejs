<script>





function loadReport(game_id = 'all', game_date = '') {

  $.post('/admin/get_today_totalbid', {
    game_id: game_id,
    game_date: game_date,
    apicount: 1
  }, function(res){

    $('#total_bid_amount').html(res.total_bid);
    $('#total_win_amount').html(res.total_win);
    $('#withd_req').html(res.total_withdraw);
    $('#total_deposit').html(res.total_deposit);
    $('#add_fund').html(res.add_fund);
    $('#total_loss_amount').html(res.total_loss);

    // reset classes first
    $('#loss_color').removeClass('bg-success bg-danger text-white');

    if(res.total_loss >= 0){
      $('#loss_color').addClass('bg-success text-white');
      $('#loss_text').text('Profit');
    } else {
      $('#loss_color').addClass('bg-danger text-white');
      $('#loss_text').text('Loss');
    }

  });
}



$(document).ready(function(){


  $.ajaxSetup({
    headers: {
      'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
    }
  });

  let today = new Date().toISOString().split('T')[0]; // yyyy-mm-dd

  $('#game_date').val(today); // input me bhi set kar do

  loadReport('all', today);

});


$('#get_report').on('click', function(){

  let game_id = $('#game_name').val() || 'all';
  let game_date = $('#game_date').val();

  if(!game_date){
    alert("Please select date");
    return;
  }

  loadReport(game_id, game_date);

});








