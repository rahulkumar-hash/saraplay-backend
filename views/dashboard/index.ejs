<!-- ================= AUTO DEPOSIT TABLE ================= -->

<div class="card mt-4">
  <div class="card-header">
    <h5>Fund Request Auto Deposit History</h5>
  </div>

  <div class="card-body table-responsive">
    <table class="table table-bordered">
      <thead>
        <tr>
          <th>#</th>
          <th>User Name</th>
          <th>Amount</th>
          <th>Txn ID</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% if(autoDeposit.length){ %>
          <% autoDeposit.forEach((row,index)=>{ %>
            <tr>
              <td><%= index+1 %></td>
              
                                    <td>
                                        <a 
                                            href="/admin/SingleUser/<%= row.user_id %>" 
                                            target="_blank"
                                            class="text-primary font-weight-bold"
                                        >
                                            <%= row.name %>
                                        </a>
                                    </td>
              <td>₹<%= row.txn_crdt %></td>
              <td><%= row.transaction_id %></td>
              <td><%= row.txn_date %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" class="text-center">No Data Found</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

</div>

<!-- ================= AJAX ================= -->

<script>
$('#searchBtn').on('click', function(){

  let game_id = $('#game_id_data').val();
  let session = $('#session').val();

  if(!game_id || !session){
    alert("Please Select Game & Market Time");
    return;
  }

  $.post('/admin/get_todaybid_details',
    { game_id, session },
    function(res){

      for(let i=0;i<=9;i++){
        $('#bid'+i).html(res['Ank'+i]);
        $('#total'+i).html(res['points'+i]);
      }

    }
  );

});
