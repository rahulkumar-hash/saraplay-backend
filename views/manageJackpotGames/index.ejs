<div class="page-bar">
  <div class="page-title-breadcrumb">
    <ol class="breadcrumb page-breadcrumb pull-right">
      <li>
        <i class="fa fa-home"></i>
        <a class="parent-item" href="/admin">Home</a>
        <i class="fa fa-angle-right"></i>
      </li>
      <li class="active">Manage Jackpot Games</li>
    </ol>
  </div>
</div>


<div class="row">
  <div class="col-sm-12">
    <div class="card">
      <div class="card-header">
        <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#jackpotModal">
          Add Game
        </button>
      </div>

      <div class="card-body">
        <table class="table table-bordered" id="jackpotTable">
          <thead>
            <tr>
              <th>#</th>
              <th>Game Name</th>
              <th>Close Time</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
        </table>
      </div>
    </div>
  </div>
</div>


<div class="modal fade"
     id="jackpotModal"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">

  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 id="jackpotModalTitle">Add Jackpot Game</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form id="jackpotForm">

          <input type="hidden" name="id" id="jackpot_id">

          <input type="text"
                 class="form-control mb-3"
                 name="name"
                 id="jackpot_name"
                 placeholder="Game Name">

          <label>Close Time</label>
          <input type="time"
                 class="form-control mb-3"
                 name="close_time"
                 id="jackpot_close_time">

          <button type="submit"
                  id="jackpotBtn"
                  class="btn btn-primary">
            Save
          </button>

        </form>
      </div>

    </div>
  </div>
</div>
