    <i class="fa fa-phone"></i>
  </a>

  <!-- WHATSAPP BUTTON -->
  <a href="https://wa.me/91<%= user.mobile %>" target="_blank" 
     class="btn btn-success btn-sm" style="background:#25D366;border:none;" 
