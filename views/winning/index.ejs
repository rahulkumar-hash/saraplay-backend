    <!-- PAGE BAR -->
    <div class="page-bar">
        <div class="page-title-breadcrumb">
            <div class="pull-left">
                <div class="page-title">Winning History Report</div>
            </div>
            <ol class="breadcrumb page-breadcrumb pull-right">
                <li>
                    <i class="fa fa-home"></i>
                    <a class="parent-item" href="/admin">Home</a>
                    <i class="fa fa-angle-right"></i>
                </li>
                <li class="active">Winning History Report</li>
            </ol>
        </div>
    </div>

    <!-- FILTER -->
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Winning History Report</h4>

                    <div class="row">

                        <div class="form-group col-md-2">
                            <label>Date</label>
                            <input type="date" id="filter_date" class="form-control digits">
                        </div>

                        <div class="form-group col-md-4">
                            <label>Game Name</label>
                            <select id="filter_game" class="form-control">
                                <option value="">-Select Game Name-</option>
                            </select>
                        </div>

                        <div class="form-group col-md-4">
                            <label>Market Time</label>
                            <select id="filter_session" class="form-control">
                                <option value="">-Select Market Type-</option>
                                <option value="Open">Open Market</option>
                                <option value="Close">Close Market</option>
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="winTable" class="table table-striped table-bordered w-100">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>User Mobile</th>
                                    <th>Bid TXN ID</th>
                                    <th>Game Name</th>
                                    <th>Game Type</th>
                                    <th>Session</th>
                                    <th>Open Paana</th>
                                    <th>Open Digit</th>
                                    <th>Close Paana</th>
                                    <th>Close Digit</th>
                                    <th>Jodi Digit</th>
                                    <th>Points</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="winBody">
                                <% if (data && data.length) { %>
                                    <% data.forEach(function(v, i){ 

                                        %>

                                        
                                        <tr>
                                            <td><%= i+1 %></td>
                                             <td>
                                                <a 
                                                    href="/admin/SingleUser/<%= v.user_id %>" 
                                                    target="_blank"
                                                    class="text-primary font-weight-bold"
                                                >
                                                    <%= v.mobile %>
                                                </a>
                                            </td>
                                            <td><%= v.txn_id %></td>
                                            <td><%= v.game_name %></td>
                                            <td><%= v.game_type %></td>
                                            <td><%= v.session %></td>
                                            <td><%= v.open_pana || 'N/A' %></td>
                                            <td><%= v.open_digit || 'N/A' %></td>
                                            <td><%= v.close_pana || 'N/A' %></td>
                                            <td><%= v.close_digit || 'N/A' %></td>
                                            <td><%= v.jodi_digit || 'N/A' %></td>
                                            <td><%= v.points %></td>
                                            <td><%= v.amount %></td>
                                            <td><%= v.date %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
                
<script>
$(document).ready(function () {

    const now = new Date();
    const day = ("0"+now.getDate()).slice(-2);
    const month = ("0"+(now.getMonth()+1)).slice(-2);
    const today = now.getFullYear()+"-"+month+"-"+day;

    $('#filter_date').val(today);

    loadGames();
    loadReport();

    $('#filter_date, #filter_game, #filter_session').on('change', function () {
        loadReport();
    });

    $('#winTable').DataTable({
        responsive: false,
        lengthMenu: [[10,25,50,100,500],[10,25,50,100,500]],
        dom:
          "<'row'<'col-md-4'l><'col-md-4'B><'col-md-4'f>>" +
          "<'row'<'col-md-12'tr>>" +
          "<'row'<'col-md-5'i><'col-md-7'p>>",
        buttons: ["copy","csv","excel","pdf","print"]
    });
});

/* ======================
   LOAD GAMES
====================== */
function loadGames(){
    $.get('/admin/get-games-for-declare', function(res){
        let html = '<option value="">-Select Game Name-</option>';
        res.forEach(g=>{
            html += `<option value="${g.id}">${g.name}</option>`;
        });
        $('#filter_game').html(html);
    });
}

/* ======================
   LOAD REPORT
====================== */
function loadReport(){
    $.post('/admin/winning-report/search',{
        date: $('#filter_date').val(),
        game_id: $('#filter_game').val(),
        session: $('#filter_session').val()
    }, function(res){

        let html = '';

        if(res.status && res.data.length){
            res.data.forEach((v,i)=>{
                html += `
                  <tr>
                    <td>${i+1}</td>
                    <td>
                        <a 
                            href="/admin/SingleUser/${v.user_id}" 
                            target="_blank"
                            class="text-primary font-weight-bold"
                        >
                            ${v.mobile}
                        </a>
                    </td>
                    <td>${v.txn_id}</td>
                    <td>${v.game_name}</td>
                    <td>${v.game_type}</td>
                    <td>${v.session}</td>
                    <td>${v.open_pana || 'N/A'}</td>
                    <td>${v.open_digit || 'N/A'}</td>
                    <td>${v.close_pana || 'N/A'}</td>
                    <td>${v.close_digit || 'N/A'}</td>
                    <td>${v.jodi_digit || 'N/A'}</td>
                    <td>${v.points}</td>
                    <td>${v.amount}</td>
                    <td>${v.date}</td>
                  </tr>`;
            });
        }else{
            html = `<tr>
                <td colspan="14" class="text-center text-danger">
                    No record found
                </td>
            </tr>`;
        }

        $('#winBody').html(html);
    });
}
</script>