
                <!-- PAGE BAR -->
                <div class="page-bar">
                    <div class="page-title-breadcrumb">
                       
                        <ol class="breadcrumb page-breadcrumb pull-right">
                            <li>
                                <i class="fa fa-home"></i>
                                <a class="parent-item" href="/admin">Home</a>
                                <i class="fa fa-angle-right"></i>
                            </li>
                            <li class="active">Transfer Point Report</li>
                        </ol>
                    </div>
                </div>

                <!-- FILTER -->
                <div class="row">
                    <div class="col-sm-12">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">Transfer Point Report</h4>

                                <div class="row">
                                    <div class="form-group col-md-4">
                                        <label>Date</label>
                                        <input type="date" id="filter_date" class="form-control digits">
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- TABLE -->
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-head">
                                <header>
                                    <button class="btn btn-info">
                                        Total Transfer Amount: ₹
                                        <span id="totalAmount"><%= totalAmount %></span>
                                    </button>
                                </header>
                            </div>

                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="transferTable" class="table table-striped table-bordered w-100">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Sender</th>
                                                <th>Receiver</th>
                                                <th>Amount</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody id="transferBody">
                                            <% if (data && data.length) { %>
                                                <% data.forEach(function(v, i){ %>
                                                    <tr>
                                                        <td><%= i+1 %></td>
                                                        <td>
                                                            <%= v.sender_name %><br>
                                                            (<%= v.sender_mobile %>)
                                                        </td>
                                                        <td>
                                                            <%= v.receiver_name %><br>
                                                            (<%= v.receiver_mobile %>)
                                                        </td>
                                                        <td>₹<%= v.txn_dbdt %></td>
                                                        <td><%= v.txn_date %></td>
                                                    </tr>
                                                <% }) %>
                                            <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

<script>
$(document).ready(function () {

    const now = new Date();
    const day = ("0"+now.getDate()).slice(-2);
    const month = ("0"+(now.getMonth()+1)).slice(-2);
    const today = now.getFullYear()+"-"+month+"-"+day;

    $('#filter_date').val(today);

    loadReport();

    $('#filter_date').on('change', function () {
        loadReport();
    });

    $('#transferTable').DataTable({
        responsive: false,
        lengthMenu: [[10,25,50,100,500,-1],[10,25,50,100,500,"All"]],
        dom:
          "<'row'<'col-md-4'l><'col-md-4'B><'col-md-4'f>>" +
          "<'row'<'col-md-12'tr>>" +
          "<'row'<'col-md-5'i><'col-md-7'p>>",
        buttons: ["copy","csv","excel","pdf","print"]
    });
});

/* ======================
   LOAD REPORT
====================== */
function loadReport(){
    $.post('/admin/transfer-point-report/search',{
        date: $('#filter_date').val()
    }, function(res){

        let html = '';

        if(res.status && res.data.length){
            res.data.forEach((v,i)=>{
                html += `
                  <tr>
                    <td>${i+1}</td>
                    <td>${v.sender_name}<br>(${v.sender_mobile})</td>
                    <td>${v.receiver_name}<br>(${v.receiver_mobile})</td>
                    <td>₹${v.txn_dbdt}</td>
                    <td>${v.txn_date}</td>
                  </tr>`;
            });
        }else{
            html = `<tr>
                <td colspan="5" class="text-center text-danger">
                    No record found
                </td>
            </tr>`;
        }

        $('#transferBody').html(html);
        $('#totalAmount').text(res.totalAmount);
    });
}
</script>