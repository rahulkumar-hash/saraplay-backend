
<div class="page-bar">
  <div class="page-title-breadcrumb">
    <ol class="breadcrumb page-breadcrumb pull-right">
      <li>
        <i class="fa fa-home"></i>
        <a class="parent-item" href="/admin">Home</a>
        <i class="fa fa-angle-right"></i>
      </li>
      <li class="active">Declare Result</li>
    </ol>
  </div>
</div>



<div class="row">

  <!-- FILTER -->
  <div class="col-md-12">
    <div class="card">
      <div class="card-header">
         <h4 class="card-title">Filter Data</h4>
      </div>
      <div class="card-body">
       

        <form id="jackpotDeclareFilterForm">
          <div class="row">

            <div class="form-group col-md-4">
              <label>Result Date</label>
              <input type="date" name="result_date" id="SubmitDate" class="form-control">
            </div>

            <div class="form-group col-md-4">
              <label>Game Name</label>
              <select name="game_id" id="game_id" class="form-control">
                <option value="">Select Game Name</option>
                <% games.forEach(g => { %>
                  <option value="<%= g.id %>"><%= g.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group col-md-2">
              <label>&nbsp;</label>
              <button class="btn btn-primary btn-block mt-4">
                Go
              </button>
            </div>

          </div>
        </form>

        <div id="error" style="display:none" class="alert alert-danger mt-2">
          Please Select Date & Game
        </div>

      </div>
    </div>
  </div>

  <!-- TABLE -->
  <div class="col-md-12">
    <div class="card">
      <div class="card-body">

        <table id="jackpotDataTable" class="display table table-striped table-bordered w-100">
          <thead>
            <tr>
              <th>#</th>
              <th>Game Name</th>
              <th>Result Date</th>
              <th>Declare Date</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>

      </div>
    </div>
  </div>

</div>
