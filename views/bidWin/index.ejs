<script>
$(document).ready(function () {

    const now = new Date();
    const day = ("0"+now.getDate()).slice(-2);
    const month = ("0"+(now.getMonth()+1)).slice(-2);
    const today = now.getFullYear()+"-"+month+"-"+day;

    $('#SubmitDate').val(today).attr("max",today);

    loadGames();

    $('#submit').on('click', function () {
        const date = $('#SubmitDate').val();
        const game_id = $('#game_id').val();

        if (!date || !game_id) {
            $('#error').show();
            setTimeout(()=>$('#error').hide(),3000);
            return;
        }

        $.post('/admin/get-win-report',{
            date,
            game_id
        }, function (res) {
            $('#dr').html(res);
        });
    });
});

/* LOAD GAMES */
function loadGames(){
    $.get('/admin/get-games-for-declare', function(res){
        let html = '<option selected disabled>-Select Game Name-</option>';
        res.forEach(g=>{
            html += `<option value="${g.id}">${g.name}</option>`;
        });
        $('#game_id').html(html);
    });
}
</script>