<div class="card border-0 shadow-sm rounded-4 mt-4">
  <div class="card-header">

    <h4 class="fw-semibold mb-4">Market Bid Details</h4>
  </div>
  <div class="card-body">

    <!-- Header -->

    <!-- Filters -->
    <div class="row align-items-end mb-4">

      <div class="col-md-4">
        <label class="form-label fw-medium">Select Date</label>
        <input type="date" class="form-control rounded-3 shadow-sm" id="game_date">
      </div>

      <div class="col-md-5">
        <label class="form-label fw-medium">Game Name</label>
        <select class="form-control rounded-3 shadow-sm" id="game_name">
          <option selected disabled>-Select Game Name-</option>
            <option value="all">All Games</option>
          <% games?.forEach(game => { %>
            <option value="<%= game.id %>"><%= game.name %></option>
          <% }) %>

        </select>
      </div>

      <div class="col-md-3">
        <button class="btn btn-primary w-100 rounded-3 shadow-sm" id="get_report">
  Get Report
</button>
      </div>

    </div>

    <!-- Stats Grid -->
    <div class="table-responsive">

      <table class="table table-bordered align-middle mb-0">

        <tr>
          <td class="fw-medium">
            Total Bid Amount: ₹<span id="total_bid_amount">0</span>
          </td>
          <td class="text-end">
            <a href="user-bid-history">
              <button class="btn btn-sm btn-outline-primary rounded-3">
                View
              </button>
            </a>
          </td>

          <td class="fw-medium">
            Withdraw Request: ₹<span id="withd_req">0</span>
          </td>
          <td class="text-end">
            <a href="withdraw-report">
              <button class="btn btn-sm btn-outline-primary rounded-3">
                View
              </button>
            </a>
          </td>
        </tr>

        <tr>
          <td class="fw-medium">
            Total Winning Amount: ₹<span id="total_win_amount">0</span>
          </td>
          <td class="text-end">
            <a href="winning-report">
              <button class="btn btn-sm btn-outline-primary rounded-3">
                View
              </button>
            </a>
          </td>

          <td class="fw-medium">
            Total Deposit (UPI): ₹<span id="total_deposit">0</span>
          </td>
          <td class="text-end">
            <a href="auto-deposit-history">
            <button class="btn btn-sm btn-outline-primary rounded-3">
              View
            </button>
            </a>
          </td>
        </tr>

        <tr>
          <!-- PROFIT / LOSS Dynamic Color -->
          <td colspan="2" id="loss_color"
              class="fw-semibold text-white"
              style="background: linear-gradient(135deg,#28a745,#218838);">

            Total <span id="loss_text">Profit</span> Amount:
            ₹<span id="total_loss_amount">0</span>

          </td>

          <td class="fw-medium">
            Add Funds (Manually): ₹<span id="add_fund">0</span>
          </td>

          <td class="text-end">
            <a href="manual-deposit-history">
            <button class="btn btn-sm btn-outline-primary rounded-3">
              View
            </button>
            </a>
          </td>
        </tr>
 
      </table>

    </div>

  </div>
</div>






