

<div class="page-bar">
  <div class="page-title-breadcrumb">
    <ol class="breadcrumb page-breadcrumb pull-right">
      <li>
        <i class="fa fa-home"></i>
        <a class="parent-item" href="/admin">Home</a>
        <i class="fa fa-angle-right"></i>
      </li>
      <li class="active">Bid History</li>
    </ol>
  </div>
</div>




<!-- FILTER -->
<div class="card mb-3">
  <div class="card-body">
    <h4 class="card-title">Bid History Report</h4>

    <form id="starlineBidFilterForm">
      <input type="hidden" id="csrf_token" value="<%- csrfToken %>">
      <div class="row">

        <div class="col-md-2">
          <label>Date</label>
          <input type="date" name="result_date" id="filter_date" class="form-control">
        </div>

        <div class="col-md-4">
          <label>Game Name</label>
          <select name="game" id="filter_game" class="form-control"></select>
        </div>

        <div class="col-md-4">
          <label>Game Type</label>
          <select name="game_type" id="filter_type" class="form-control">
            <option value="">-Select Game Type-</option>
            <option value="all">All Type</option>
            <option value="Single Digit">Single Digit</option>
            <option value="Single Pana">Single Pana</option>
            <option value="Double Pana">Double Pana</option>
            <option value="Triple Pana">Triple Pana</option>
          </select>
        </div>

        <div class="col-md-2 mt-4">
          <button class="btn btn-primary w-100">
            Submit
          </button>
        </div>

      </div>
    </form>
  </div>
</div>

<!-- TABLE -->
<div class="card">
  <div class="card-body">
    <table class="table table-bordered w-100" id="bidTable">
      <thead>
        <tr>
          <th>#</th>
          <th>User Mobile</th>
          <th>Bid TXN ID</th>
          <th>Game Name</th>
          <th>Game Type</th>
          <th>Digit</th>
          <th>Pana</th>
          <th>Points</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>

<script>
$(document).ready(function () {

  const csrfToken = $("#csrf_token").val();

  // ── DataTable — sirf ek baar init karo ──────────────────
  let table = null;

  function initTable(data) {
    if ($.fn.DataTable.isDataTable("#bidTable")) {
      $("#bidTable").DataTable().destroy();
      $("#bidTable tbody").empty();
    }

    let sr = 1;
    table = $("#bidTable").DataTable({
      data: data,
      processing: true,
      ordering: true,
      pageLength: 25,
      columns: [
        { data: null,         render: () => sr++ },
        { data: "mobile",     defaultContent: "N/A" },
        { data: "bid_txn_id", defaultContent: "N/A" },
        { data: "game_name",  defaultContent: "N/A" },
        { data: "game_type",  defaultContent: "N/A" },
        {
          data: null,
          defaultContent: "N/A",
          render: function (d, t, row) {
            const gt = String(row.game_type || "").toLowerCase().trim();
            const digitTypes = ["single digit", "odd even", "two digit panna"];
            const isDigit = digitTypes.some(type => gt.includes(type));
            return isDigit ? (row.pana || "N/A") : "N/A";
          }
        },
        {
          data: null,
          defaultContent: "N/A",
          render: function (d, t, row) {
            const gt = String(row.game_type || "").toLowerCase().trim();
            const digitTypes = ["single digit", "odd even", "two digit panna"];
            const isDigit = digitTypes.some(type => gt.includes(type));
            return !isDigit ? (row.pana || "N/A") : "N/A";
          }
        },
        { data: "points",    defaultContent: "0" },
        { data: "game_date", defaultContent: "N/A" }
      ]
    });
  }

  // ── Load data from API ───────────────────────────────────
  function loadData() {
    const payload = {
      _csrf:       csrfToken,
      result_date: $("#filter_date").val() || "",
      game:        $("#filter_game").val() || "",
      game_type:   $("#filter_type").val() || ""
    };

    $.post("/admin/starline-bid-history/data", payload)
      .done(function (res) {
        console.log("API response:", res);
        initTable(res.status && res.data ? res.data : []);
      })
      .fail(function (xhr) {
        console.error("Request failed:", xhr.status, xhr.responseText);
        initTable([]);
      });
  }

  // ── Page load pe seedha sab data load karo ─────────────
  loadData();

  // ── Filter submit ────────────────────────────────────────
  $("#starlineBidFilterForm").on("submit", function (e) {
    e.preventDefault();
    loadData();
  });

});
</script>
