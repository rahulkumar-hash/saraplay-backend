    <div class="card mt-4">
      <div class="card-header">
         <h4>Total Bids On Single Ank Of Date <%= new Date().toDateString() %></h4>

      </div>
  <div class="card-body">
   
    <div class="row">
      <div class="col-md-5">
        <label>Game Name</label>
        <select id="game_id_data" class="form-control">
          <option disabled selected>-Select Game Name-</option>
          <% games?.forEach(game => { %>
            <option value="<%= game.id %>"><%= game.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="col-md-5">
        <label>Market Time</label>
        <select id="session" class="form-control">
          <option disabled selected>-Select Market Time-</option>
          <option value="Open">Open Market</option>
          <option value="Close">Close Market</option>
        </select>
      </div>

      <div class="col-md-2 mt-4">
        <button class="btn btn-primary btn-block" id="searchBtn">Get</button>
      </div>
    </div>
  </div>
