<!-- PAGE BAR -->
<div class="page-bar">
  <div class="page-title-breadcrumb">
    <ol class="breadcrumb page-breadcrumb pull-right">
      <li>
        <i class="fa fa-home"></i>
        <a class="parent-item" href="/admin">Home</a>
        <i class="fa fa-angle-right"></i>
      </li>
      <li class="active">Manage Starline Games</li>
    </ol>
  </div>
</div>



<div class="row">
  <div class="col-sm-12">

      <div class="card">
        <div class="card-header">
          <header>
            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#starlineModal">
              Add Game
            </button>
          </header>
        </div>

        <div class="card-body">
          <table class="table table-bordered" id="starlineTable">
            <thead>
              <tr>
                <th>#</th>
                <th>Name</th>
                <th>Hindi Name</th>
                <th>Open Time</th>
                <th>Status</th>
                <th>Market</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="starlineBody"></tbody>
          </table>
        </div>
      </div>

  </div>
</div>




