<script>
const userId = <%= user.id %>;
const csrfToken = "<%= csrfToken %>";
</script>

<script>
  
  
  document.querySelector("#addFundBtn").addEventListener("click", async () => {

  const amount = document.querySelector("#addFundAmount").value;

  if (!amount || amount <= 0) {
    // alert("Enter valid amount");
    notyf.error('Enter valid amount');
    return;
  }

  const res = await fetch("/admin/user-add-fund", {

    method: "POST",

    headers: {
      "Content-Type": "application/json",
      "CSRF-Token": csrfToken
    },

    body: JSON.stringify({
      user_id: userId,
      amount: amount
    })

  });

  const data = await res.json();

  notyf.success(data.message);

  location.reload();

});




document.querySelector("#withdrawBtn").addEventListener("click", async () => {

  const amount = document.querySelector("#withdrawAmount").value;

  if (!amount || amount <= 0) {
    notyf.error("Enter valid amount");
    return;
  }

  const res = await fetch("/admin/user-withdraw-fund", {

    method: "POST",

    headers: {
      "Content-Type": "application/json",
      "CSRF-Token": csrfToken
    },

    body: JSON.stringify({
      user_id: userId,
      amount: amount
    })

  });

  const data = await res.json();

  notyf.success(data.message);

  location.reload();

});



</script>

<script>
function resetPassword(userId) {

  Swal.fire({
    title: "Are you sure?",
    text: "Password will be reset to 12345678",
    icon: "warning",
    showCancelButton: true,
    confirmButtonText: "Yes, Reset"
  }).then((result) => {

    if (result.isConfirmed) {

      fetch("/webapi/reset-password", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "CSRF-Token": csrfToken
        },
        body: JSON.stringify({
          user_id: userId,
          password: "12345678"
        })
      })
      .then(res => res.json())
      .then(data => {

        if (data.success) {
          Swal.fire("Success", "Password Reset Successfully", "success");
          location.reload();
        } else {
          Swal.fire("Error", "Failed to reset password", "error");
        }

      });

    }

  });

}
</script>

<script>

$(document).ready(function(){

    const userId = "<%= user.id %>";  // user id from backend

    loadUserBids(userId);
    loadWalletHistory(userId);
});











function loadUserBids(userId){

    $.ajax({
        url: "/admin/SingleUserBidHis/" + userId,
        type: "GET",
        success:function(res){

            let html = '';

            if(res.status && res.data.length){

                res.data.forEach((v,i)=>{

                  const formatted = new Date(v.date).toLocaleString("en-IN", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric",
                      hour: "2-digit",
                      minute: "2-digit",
                      hour12: true
                    });


                    html += `
                    <tr>

                        <td>${i+1}</td>
                        <td>${v.bid_txn_id}</td>
                        <td>${v.game_name}</td>
                        <td>${v.game_type}</td>
                        <td>${v.session}</td>
                        <td>${v.open_paana || 'N/A'}</td>
                        <td>${v.open_digit || 'N/A'}</td>
                        <td>${v.close_paana || 'N/A'}</td>
                        <td>${v.close_digit || 'N/A'}</td>
                        <td>${v.jodi_digit || 'N/A'}</td>
                        <td>${v.points}</td>
                        <td>${formatted}</td>

                        
                    </tr>
                    `;

                });

            }else{

                html = `
                <tr>
                    <td colspan="13" class="text-center text-muted">
                        No data available
                    </td>
                </tr>
                `;

            }

            $("#bidBody").html(html);

        }
    });

}

function loadWalletHistory(userId){

    $.ajax({



        url: "/admin/wallet-history/" + userId,
        type: "GET",

        success:function(res){

            let html = '';

            if(res.status && res.data.length){

                res.data.forEach((v,i)=>{

                    let amount = '';
                    let color = '';

                    if(v.txn_crdt > 0){
                        amount = '₹'+v.txn_crdt+' Credit';
                        color = 'text-success';
                    }else{
                        amount = '₹'+v.txn_dbdt+' Debit';
                        color = 'text-danger';
                    }

                    html += `
                    <tr>

                        <td>${i+1}</td>
                        <td>${v.transaction_id || '-'}</td>
                        <td>${v.txn_date}</td>
                        <td class="${color} fw-bold">${amount}</td>
                        <td>${v.txn_comment}</td>

                    </tr>
                    `;

                });

            }else{

                html = `
                <tr>
                    <td colspan="5" class="text-center text-muted">
                    No data available
                    </td>
                </tr>
                `;

            }

            $("#walletBody").html(html);

        }

    });

}






document.querySelector("#changePinBtn").addEventListener("click", async () => {

  const pin = document.querySelector("#newPin").value;

  if(!pin || pin.length !== 4){
    notyf.error("Enter 4 digit pin");
    return;
  }

  const res = await fetch("/admin/change-user-pin", {

    method:"POST",

    headers:{
      "Content-Type":"application/json",
      "CSRF-Token":csrfToken
    },

    body: JSON.stringify({
      user_id: userId,
      pin: pin
    })

  });

  const data = await res.json();

  notyf.success(data.message);

  if(data.success){
    location.reload();
  }

});











function changeStatus(id, column, status, text) {

  Swal.fire({
    title: "Are you sure?",
    text: "You want to " + text,
    icon: "warning",
    showCancelButton: true,
    confirmButtonText: "Yes"
  }).then((result) => {

    if (result.isConfirmed) {

      $.ajax({
        url: "/admin/user/status-update",
        type: "POST",
        data: {
          id: id,
          column: column,
          status: status
        },
        success: function (res) {

          if (res.success) {

            Swal.fire(
              "Success",
              "Status Updated Successfully",
              "success"
            );

            location.reload();
          } else {

            Swal.fire(
              "Error",
              "Update Failed",
              "error"
            );

          }

        }

      });

    }

  });

}










function DeleteUser(id) {

  const csrfToken = document
    .querySelector('meta[name="csrf-token"]')
    .getAttribute("content");

  Swal.fire({
    title: "Are you sure?",
    text: "This user will be deleted!",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#d33",
    cancelButtonColor: "#3085d6",
    confirmButtonText: "Yes, Delete it!"
  }).then((result) => {

    if (result.isConfirmed) {

      $.ajax({
        url: "/admin/user-delete",
        type: "POST",
        headers: {
          "CSRF-Token": csrfToken
        },
        data: {
          id: id
        },
        success: function (res) {

          if (res.success) {

            Swal.fire({
              title: "Deleted!",
              text: res.message,
              icon: "success",
              timer: 1500,
              showConfirmButton: false
            });

            // reload table without reset pagination
            // $('#usersTable').DataTable().ajax.reload(null, false);
            location.href="Users";

          } else {

            Swal.fire(
              "Error",
              res.message || "Delete Failed",
              "error"
            );

          }

        },
        error: function () {
          Swal.fire(
            "Error",
            "Server Error",
            "error"
          );
        }
      });

    }

  });

}
</script>











<script>
const csrfToken1 = document.querySelector('meta[name="csrf-token"]').getAttribute("content");

$(document).ready(function () {
  loadWithdrawData();
});

function loadWithdrawData() {

  $.ajax({
    url: "/admin/admin-withdraw-list",
    type: "POST",
    headers: {
      "CSRF-Token": csrfToken1
    },
    data: {
      user_id: "<%= user.id %>"
    },
    success: function (res) {

      let html = '';

      if (res.data.length > 0) {

        res.data.forEach((row, index) => {

          html += `
            <tr>
              <td>${index + 1}</td>
              <td>₹${row.amount}</td>
              <td>${row.txn_id}</td>
              <td>${row.payment_mode}</td>
              <td>${row.reason ?? '-'}</td>
              <td>${row.date}</td>
              <td>
                ${row.status === 'Pending'
                  ? '<span class="badge bg-warning">Pending</span>'
                  : row.status === 'Accepted'
                  ? '<span class="badge bg-success">Accepted</span>'
                  : '<span class="badge bg-danger">Rejected</span>'}
              </td>
              <td>
                ${row.status === 'Pending'
                  ? `<button class="btn btn-success btn-sm"
                      onclick="updateWithdraw(${row.id},'Accepted')">Approve</button>
                     <button class="btn btn-danger btn-sm"
                      onclick="updateWithdraw(${row.id},'Rejected')">Reject</button>`
                  : '-'}
              </td>
            </tr>
          `;
        });

      } else {
        html = `
          <tr>
            <td colspan="8" class="text-center text-muted">
              No data available
            </td>
          </tr>
        `;
      }

      $("#withdrawTable tbody").html(html);

    }
  });

}


function updateWithdraw(id, status) {

  const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute("content");

  Swal.fire({
    title: "Are you sure?",
    text: "You want to " + status + " this request",
    icon: "warning",
    showCancelButton: true
  }).then((result) => {

    if (result.isConfirmed) {

      $.ajax({
        url: "/admin/admin-withdraw-update",
        type: "POST",
        headers: {
          "CSRF-Token": csrfToken
        },
        data: { id, status },
        success: function (res) {

          if (res.success) {
            Swal.fire("Updated", "", "success");
            loadWithdrawData();
          }

        }
      });

    }

  });

}
</script>


<script>

$(document).ready(function(){

    const userId = "<%= user.id %>";

    loadWinningHistory(userId);

    $("#winningDate").on("change", function(){

        loadWinningHistory(userId, $(this).val());

    });

});





function loadWinningHistory(userId, date=''){

    $.ajax({

        url: "/admin/winning-history/" + userId,

        type: "GET",

        data:{
            date: date
        },

        success:function(res){

            let html = '';

            if(res.status && res.data.length){

                res.data.forEach((v,i)=>{

                    html += `
                    <tr>

                        <td>${i+1}</td>

                        <td>${v.txn_id ?? '-'}</td>

                        <td>${v.game_name ?? '-'}</td>

                        <td>${v.game_type ?? '-'}</td>

                        <td>${v.session ?? '-'}</td>

                        <td>
                            ${v.pana }
                        </td>

                        <td class="text-success fw-bold">
                            ₹${v.amount ?? 0}
                        </td>

                        <td>${v.date ?? '-'}</td>

                    </tr>
                    `;
                });

            }else{

                html = `
                <tr>
                    <td colspan="8" class="text-center text-muted">
                        No Winning Data Found
                    </td>
                </tr>
                `;
            }

            $("#winningBody").html(html);

        }

    });

}

</script>
