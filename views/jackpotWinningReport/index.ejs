

<div class="page-bar">
  <div class="page-title-breadcrumb">
    <ol class="breadcrumb page-breadcrumb pull-right">
      <li>
        <i class="fa fa-home"></i>
        <a class="parent-item" href="/admin">Home</a>
        <i class="fa fa-angle-right"></i>
      </li>
      <li class="active">Jackpot Winning Report</li>
    </ol>
  </div>
</div>



<div class="row">

  <!-- FILTER -->
  <div class="col-sm-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Jackpot Winning Report</h4>

        <form id="jackpotWinningFilterForm">
          <div class="row">

            <div class="form-group col-md-4">
              <label>Date</label>
              <input type="date" name="result_date" class="form-control">
            </div>

            <div class="form-group col-md-4">
              <label>Game Name</label>
              <select name="game" class="form-control">
                <option value="">-Select Game Name-</option>
                <% games.forEach(g => { %>
                  <option value="<%= g.id %>"><%= g.name %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-group col-md-2">
              <label>&nbsp;</label>
              <button class="btn btn-primary btn-block mt-4">
                Submit
              </button>
            </div>

          </div>
        </form>

      </div>
    </div>
  </div>

  <!-- TABLE -->
  <div class="col-md-12">
    <div class="card">
      <div class="card-body">

        <div class="table-responsive">
          <table id="jackpot_winning_table" class="display table table-striped table-bordered w-100">
            <thead>
              <tr>
                <th>#</th>
                <th>User Mobile</th>
                <th>Bid TXN ID</th>
                <th>Game Name</th>
                <th>Bid On</th>
                <th>Bid Amount</th>
                <th>Win Amount</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>

      </div>
    </div>
  </div>

</div>