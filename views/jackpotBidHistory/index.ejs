


<div class="page-bar">
  <div class="page-title-breadcrumb">
    <ol class="breadcrumb page-breadcrumb pull-right">
      <li>
        <i class="fa fa-home"></i>
        <a class="parent-item" href="/admin">Home</a>
        <i class="fa fa-angle-right"></i>
      </li>
      <li class="active">Jackpot Bid History</li>
    </ol>
  </div>
</div>

<div class="row">

  <div class="col-sm-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Bid History Report</h4>

        <form id="jackportfilterForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="row">

    <div class="form-group col-md-2">
      <label>Date</label>
      <input type="date"
             name="result_date"
             class="form-control">
    </div>

    <div class="form-group col-md-4">
      <label>Game Name</label>
      <select name="game" class="form-control">
        <option value="">-Select Game Name-</option>
        <% games.forEach(g => { %>
          <option value="<%= g.id %>"><%= g.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-group col-md-2">
      <label>&nbsp;</label>
      <button type="submit"
              class="btn btn-primary btn-block mt-4">
        Filter
      </button>
    </div>

  </div>
</form>

        

      </div>
    </div>
  </div>

  <div class="col-md-12">
    <div class="card">
      <div class="card-body">
        <div class="table-responsive">

          <table id="example1" class="display table table-striped table-bordered w-100">
            <thead>
              <tr>
                <th>#</th>
                <th>User Mobile</th>
                <th>Game Name</th>
                <th>Bid On</th>
                <th>Bid Amount</th>
                <th>Win Amount</th>
                <th>Date</th>
              </tr>
            </thead>

            

          </table>

        </div>
      </div>
    </div>
  </div>

</div>